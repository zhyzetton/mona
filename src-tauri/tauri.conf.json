{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mono",
  "version": "0.1.0",
  "identifier": "com.zetton.mono",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mono",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.mona/posters/**",
          "$HOME/.mona/detail_imgs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
